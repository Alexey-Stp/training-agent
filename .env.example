# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/triathlon_coach

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Application
NODE_ENV=development
LOG_LEVEL=info

# Encryption key for stored secrets (intervals.icu API keys), AES-256-GCM.
# Must be base64 of 32 bytes. Generate with: openssl rand -base64 32
SECRETS_ENC_KEY=
# During key rotation, set the old key here so existing secrets stay readable (decrypt-only)
# SECRETS_ENC_KEY_PREVIOUS=

# Default timezone
DEFAULT_TIMEZONE=Europe/Prague

# intervals.icu integration
ICU_ATHLETE_ID=i12345
ICU_API_KEY=your_icu_api_key_here

# intervals.icu activity sync (worker). Per linked athlete, repeats every N minutes.
ICU_ACTIVITY_SYNC_EVERY_MIN=30
# Days of history pulled on an athlete's first sync
ICU_ACTIVITY_BACKFILL_DAYS=90
# Days re-read before the last sync on each run, to catch late uploads and edits
ICU_ACTIVITY_SYNC_OVERLAP_DAYS=2

# intervals.icu wellness sync (HRV, RHR, sleep, weight, CTL/ATL/TSB). Per linked athlete, repeats
# every N minutes (1440 = daily). /sync also pulls it on demand.
ICU_WELLNESS_SYNC_EVERY_MIN=1440
# Days of wellness history pulled on an athlete's first sync
ICU_WELLNESS_BACKFILL_DAYS=90
# Days re-read before the last sync; ICU recomputes CTL/ATL when late activities arrive
ICU_WELLNESS_SYNC_OVERLAP_DAYS=3
