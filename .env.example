# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/triathlon_coach

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Application
NODE_ENV=development
LOG_LEVEL=info

# Encryption key for stored secrets (intervals.icu API keys), AES-256-GCM.
# Must be base64 of 32 bytes. Generate with: openssl rand -base64 32
SECRETS_ENC_KEY=
# During key rotation, set the old key here so existing secrets stay readable (decrypt-only)
# SECRETS_ENC_KEY_PREVIOUS=

# Default timezone
DEFAULT_TIMEZONE=Europe/Prague

# intervals.icu integration
ICU_ATHLETE_ID=i12345
ICU_API_KEY=your_icu_api_key_here

# intervals.icu activity sync (worker). Per linked athlete, repeats every N minutes.
ICU_ACTIVITY_SYNC_EVERY_MIN=30
# Days of history pulled on an athlete's first sync
ICU_ACTIVITY_BACKFILL_DAYS=90
# Days re-read before the last sync on each run, to catch late uploads and edits
ICU_ACTIVITY_SYNC_OVERLAP_DAYS=2

# intervals.icu wellness sync (HRV, RHR, sleep, weight, CTL/ATL/TSB). Per linked athlete, repeats
# every N minutes (1440 = daily). /sync also pulls it on demand.
ICU_WELLNESS_SYNC_EVERY_MIN=1440
# Days of wellness history pulled on an athlete's first sync
ICU_WELLNESS_BACKFILL_DAYS=90
# Days re-read before the last sync; ICU recomputes CTL/ATL when late activities arrive
ICU_WELLNESS_SYNC_OVERLAP_DAYS=3

# intervals.icu planned-workout reconcile. Per linked athlete, every N minutes the worker compares
# the pushed /plan push events with intervals.icu and flags sessions the athlete moved or edited there
ICU_PLAN_RECONCILE_EVERY_MIN=60

# Season rolling publisher. Per linked athlete with an active season, every N minutes the worker
# expands and pushes local days T+1..T+WINDOW (today and earlier are never touched). Each run uses
# the athlete's local date, so a 6h interval reaches the next day's window within 6h of midnight.
SEASON_PUBLISH_EVERY_MIN=360
SEASON_PUBLISH_WINDOW_DAYS=14

# LLM coach (@triathlon/ai). "mock" needs no key; "anthropic" requires AI_API_KEY.
AI_PROVIDER=mock
AI_MODEL=claude-opus-5-5
AI_API_KEY=
AI_TIMEOUT_MS=30000
# Token budget of a rendered coaching prompt. Over it, the oldest training history, then coach
# decisions, then wellness trend days are dropped; races and key sessions are always kept.
AI_CONTEXT_TOKEN_BUDGET=6000
# Free-form coach chat: messages per athlete per local day. Over it, a notice is sent and no LLM call is made.
COACH_CHAT_DAILY_LIMIT=30
# Apply / Keep plan / Discuss buttons under a morning brief or chat suggestion expire after this many
# hours; a later tap gets an "expired" notice that points to /plan today.
COACH_DECISION_TTL_HOURS=24

# Morning brief. Per linked athlete, the worker runs wellness sync -> activity sync -> coach -> brief
# once per local day at Profile.briefTime (HH:mm, athlete timezone). NULL briefTime uses the default.
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_DEFAULT_TIME=06:30
# Morning check-in. When today's device wellness is missing or HRV is more than 1 SD from the 30-day
# baseline, the brief first asks readiness 1-5 and soreness none/mild/severe. It goes out once both
# are answered, or after this many minutes with whatever was answered ("No check-in today" if nothing).
DAILY_CHECKIN_TIMEOUT_MINUTES=15

# Evening close-out. Per linked athlete, the worker runs a final activity sync, then matches the day's
# activities to its planned sessions (completed / skipped, deviation, intensity guess) once per local
# day at Profile.closeoutTime (HH:mm, athlete timezone). NULL closeoutTime uses the default. Quiet by
# default: a message only for a missed key session, an unplanned workout, or a matched session whose
# duration is off by more than CLOSEOUT_DEVIATION_THRESHOLD_PCT percent.
EVENING_CLOSEOUT_ENABLED=true
EVENING_CLOSEOUT_DEFAULT_TIME=20:30
CLOSEOUT_DEVIATION_THRESHOLD_PCT=25

# Weekly stats. Every Monday at WEEKLY_STATS_TIME (HH:mm, athlete timezone) the worker computes the
# previous ISO week per linked athlete: planned vs actual minutes per sport (compliance %), actual
# distance and TSS, key sessions hit/missed, Z1-2 vs Z3+ minutes by average HR against Profile.lthr,
# CTL/ATL/TSB start to end and a wellness summary. Stored in WeeklyStats, one row per ISO week.
WEEKLY_STATS_ENABLED=true
WEEKLY_STATS_TIME=06:00

# Weekly review. Every Sunday at WEEKLY_REVIEW_TIME (HH:mm, athlete timezone) the worker syncs
# activities, recomputes this week's stats and asks the coach LLM for a review (summary, wins,
# concerns) plus changes to next week's sessions. The changes pass the guardrails, including a ramp
# cap: they may add at most WEEKLY_REVIEW_MAX_RAMP_PCT percent to next week's planned minutes. The
# report has an "Apply next week" button (expires after COACH_DECISION_TTL_HOURS).
WEEKLY_REVIEW_ENABLED=true
WEEKLY_REVIEW_TIME=19:00
WEEKLY_REVIEW_MAX_RAMP_PCT=8
