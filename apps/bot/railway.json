{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/bot/Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "overlapSeconds": 0,
    "drainingSeconds": 5,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
