generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(cuid())
  telegramId BigInt    @unique
  createdAt  DateTime  @default(now())
  profile    Profile?
  workouts   Workout[]
  wellness   Wellness[]
  processedMessages ProcessedMessage[]
  icuConnection     IcuConnection?
  activities        Activity[]
  plannedSessions   PlannedSession[]
  races             Race[]
  seasonPlans       SeasonPlan[]
  llmCallLogs       LlmCallLog[]
  coachDecisions    CoachDecision[]
  coachChatMessages CoachChatMessage[]
  dailyBriefRuns    DailyBriefRun[]

  @@index([telegramId])
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ftp           Int      @default(355)
  timezone      String   @default("Europe/Prague")
  swimDays      Json     @default("[\"Wed\",\"Fri\",\"Sun_optional\"]")
  bikeVo2Day    String   @default("Thu")
  longBikeDay   String   @default("Sun")
  noLongRunDay  String   @default("Sun")
  briefTime     String? // HH:mm local time of the morning brief; NULL uses DAILY_BRIEF_DEFAULT_TIME
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

enum Sport {
  swim
  bike
  run
  strength
  rest
  other
}

enum Intensity {
  z1
  z2
  z3
  z4
  z5
}

model Workout {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport       Sport
  durationMin Int
  intensity   Intensity?
  date        String     // YYYY-MM-DD format
  createdAt   DateTime   @default(now())

  @@index([userId, date])
  @@index([userId])
}

// Daily wellness (see apps/worker/src/wellness-sync.ts). Device/ICU columns are
// overwritten by sync; subjective columns are only written by athlete check-ins
model Wellness {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                String   // YYYY-MM-DD in the athlete's local time (ICU wellness id)
  hrv                 Float?   // rMSSD, ms
  restingHr           Int?
  sleepHours          Float?
  sleepScore          Int?
  weightKg            Float?
  ctl                 Float?   // fitness
  atl                 Float?   // fatigue
  tsb                 Float?   // form = ctl - atl
  subjectiveReadiness Int?     // 1-5, athlete check-in
  soreness            Int?     // athlete check-in
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, date])
}

// For idempotency - track processed Telegram messages
model ProcessedMessage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramMessageId Int
  processedAt     DateTime @default(now())

  @@unique([userId, telegramMessageId])
  @@index([userId])
}

// intervals.icu account link — one per user. API key is AES-256-GCM encrypted (see core/crypto.ts)
model IcuConnection {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  icuAthleteId       String
  icuAthleteName     String?
  apiKeyCiphertext   String    // base64(ciphertext || authTag)
  apiKeyIv           String    // base64 12-byte IV
  lastActivitySyncAt DateTime?
  lastWellnessSyncAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Executed activity pulled from intervals.icu (see apps/worker/src/activity-sync.ts)
model Activity {
  id             String   @id @default(cuid())
  icuId          String
  userId         String
  icuAthleteId   String   // athlete it was synced from; re-linking another athlete purges these
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport          Sport
  icuType        String   // raw ICU type, e.g. "VirtualRide"
  name           String
  startTime      DateTime // UTC
  startDateLocal String   // YYYY-MM-DD in the athlete's local time
  durationSec    Int      // moving time, falls back to elapsed time
  distanceM      Float?
  load           Int?     // icu_training_load (TSS-equivalent)
  avgHr          Int?
  avgPower       Int?
  source         String?  // GARMIN_CONNECT, STRAVA, UPLOAD, ...
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, icuId])
  @@index([userId, startTime])
}

enum PlannedSessionStatus {
  draft               // local changes not yet in intervals.icu
  pushed              // intervals.icu event matches the local session
  modified_externally // athlete moved/edited/deleted the event in intervals.icu; their version wins
  completed
  skipped
}

// Planned workout, pushed to the intervals.icu calendar (see apps/worker/src/plan-push.ts)
model PlannedSession {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String               // YYYY-MM-DD in the athlete's local time
  slot           String               // "<sport>-<n>": nth session of that sport on the date
  sport          Sport
  title          String
  description    String?              // coach notes
  durationMin    Int
  intensity      Intensity
  steps          Json                 // WorkoutBlock[] (core workout.ts)
  status         PlannedSessionStatus @default(draft)
  icuEventId     Int?
  pushedHash     String?              // hash of the ICU event as returned by our last write
  pushedAt       DateTime?
  externalChange String?              // why reconcile flagged it, e.g. "moved to 2026-10-02"
  deletedAt      DateTime?            // local tombstone: push deletes the ICU event, then the row
  coachDecisionId String?             // applied coach decision that changed the row: /plan and the season
                                      // publisher leave the row alone, and push keeps its tombstone
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, date, slot])
  @@index([userId, status])
}

enum RacePriority {
  A
  B
  C
}

enum RaceType {
  sprint
  olympic
  half
  full
  run
  other
}

enum SeasonPlanStatus {
  draft
  active
  completed
  archived
}

enum TrainingBlockType {
  base
  build
  peak
  taper
  race
  recovery
  transition
}

// Target race on the athlete's calendar
model Race {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String       // YYYY-MM-DD in the athlete's local time
  name        String
  priority    RacePriority
  type        RaceType
  seasonPlans SeasonPlan[] @relation("ARace")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, date])
}

// Season periodization: ordered TrainingBlocks leading to the A-race.
// Invariants (contiguity, taper before A-race) live in core season/validate.ts
model SeasonPlan {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate String           // YYYY-MM-DD, first block's start
  aRaceId   String?
  aRace     Race?            @relation("ARace", fields: [aRaceId], references: [id], onDelete: SetNull)
  status    SeasonPlanStatus @default(draft)
  blocks    TrainingBlock[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, status])
}

model TrainingBlock {
  id                String            @id @default(cuid())
  seasonPlanId      String
  seasonPlan        SeasonPlan        @relation(fields: [seasonPlanId], references: [id], onDelete: Cascade)
  order             Int               // 1-based position in the season
  type              TrainingBlockType
  startDate         String            // YYYY-MM-DD; block ends startDate + weeks*7 - 1
  weeks             Int
  focus             String
  targetWeeklyHours Float
  targetSwimM       Int               // per week
  targetBikeH       Float             // per week
  targetRunKm       Float             // per week
  targetCtl         Float?            // fitness at block end
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([seasonPlanId, order])
}

enum LlmCallStatus {
  ok
  error
  timeout
}

// One row per LLM call (written by @triathlon/ai withCallLog) for cost and latency tracking
model LlmCallLog {
  id               String        @id @default(cuid())
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  purpose          String
  promptVersion    String
  provider         String
  model            String        // model that served the call
  status           LlmCallStatus
  errorType        String?       // error class name when status != ok
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  cacheReadTokens  Int           @default(0)
  cacheWriteTokens Int           @default(0)
  latencyMs        Int
  costEstimate     Decimal?      @db.Decimal(12, 6) // USD; NULL when the model has no known price
  createdAt        DateTime      @default(now())

  @@index([purpose, createdAt])
  @@index([userId, createdAt])
}

enum CoachDecisionSource {
  llm
  repaired
  fallback
}

enum GuardrailVerdict {
  accept
  clamp
  reject
}

enum CoachAction {
  keep
  reduce
  swap
  move
  rest
}

enum CoachDecisionOrigin {
  daily
  chat
}

// One row per daily coaching run, whatever its outcome (packages/ai suggestion/run.ts), and one
// per coach-chat suggestion (packages/ai chat/run.ts)
model CoachDecision {
  id                      String              @id @default(cuid())
  userId                  String
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                    String // YYYY-MM-DD in the athlete's local time
  promptVersion           String // daily context prompt
  suggestionPromptVersion String
  contextHash             String // sha256 of the prompt sent to the LLM
  source                  CoachDecisionSource
  fallbackReason          String? // llm_unavailable | invalid_output | guardrail_reject | internal_error
  attempts                Int // LLM calls made, at most 2
  rawResponses            Json // string[], one per LLM reply
  suggestion              Json? // parsed CoachSuggestion, before guardrails
  verdict                 GuardrailVerdict? // NULL when no suggestion reached the guardrails
  reasons                 Json // string[]
  finalAction             CoachAction
  finalChanges            Json // SessionDiff[]
  summary                 String
  athleteMessage          String
  accepted                Boolean? // the athlete's answer; NULL until answered
  answeredAt              DateTime?
  origin                  CoachDecisionOrigin @default(daily)
  createdAt               DateTime            @default(now())

  @@index([userId, date])
}

enum CoachChatRole {
  user
  coach
}

// Free-form coach chat, both directions; the latest rows are the history sent to the LLM
model CoachChatMessage {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              CoachChatRole
  text              String
  telegramMessageId Int? // the athlete's message the row answers or is; a retried job upserts
  coachDecisionId   String? // the suggestion offered with a coach reply
  createdAt         DateTime      @default(now())

  @@unique([userId, telegramMessageId, role])
  @@index([userId, createdAt])
}

enum DailyBriefStatus {
  pending
  running
  sent
  failed
}

// One morning pipeline run per athlete and local day (apps/worker daily-loop/pipeline.ts)
model DailyBriefRun {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String // YYYY-MM-DD in the athlete's local time
  status          DailyBriefStatus @default(pending)
  startedAt       DateTime? // lease of the run in progress
  coachDecisionId String?
  briefText       String? // rendered brief (Telegram HTML); a retry resends it
  briefKeyboard   Json? // InlineButton[][] sent with the brief
  stale           Boolean          @default(false) // an ICU sync failed, data as of dataAsOf
  dataAsOf        DateTime?
  stageTimings    Json             @default("{}") // stage → ms
  error           String?
  sentAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, date])
}
